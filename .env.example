# Demo is the safe default and can never place a phone call.
VINRELEASE_MODE=demo

# Required only for VINRELEASE_MODE=live.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
PUBLIC_BASE_URL=http://localhost:3000

# Consenting, team-controlled E.164 recipients required for live mode.
CALLE_AUCTION_PHONE=
CALLE_LIENHOLDER_PHONE=
